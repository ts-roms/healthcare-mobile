{
  "expo": {
    "name": "MyHealth",
    "slug": "my-health",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myhealth",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "ph.healthcare.myhealth"
    },
    "android": {
      "package": "ph.healthcare.myhealth",
      "adaptiveIcon": {
        "backgroundColor": "#1E7A8C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E7A8C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0D1A1F",
            "image": "./assets/images/splash-icon.png"
          },
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1E7A8C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f6f095fe-fdd7-4503-973b-58b93d186e01"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "owner": "iamromss-team"
  }
}

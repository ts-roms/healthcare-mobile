{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api-production-1eb6.up.railway.app/api/v1",
        "EXPO_PUBLIC_PORTAL_BASE_URL": "https://portal-production-c1a4.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api-production-1eb6.up.railway.app/api/v1",
        "EXPO_PUBLIC_PORTAL_BASE_URL": "https://portal-production-c1a4.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

# Built into the app (EXPO_PUBLIC_* values are readable in the binary — never put a secret here).
# Copy to .env.local. From a phone or emulator use the development machine's address, not "localhost".
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3333/api/v1
# The organization this build serves (organization.code).
EXPO_PUBLIC_ORGANIZATION_CODE=demo
# Optional: MyHealth on the web (online consultations open there, decision D8).
EXPO_PUBLIC_PORTAL_BASE_URL=http://192.168.1.10:3001
# Store and development builds: the Expo project (written by `eas init`). Needed for push notifications.
EAS_PROJECT_ID=
